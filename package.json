  "license": "MIT",
  "author": "Harshit Singh Bhandari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshitsinghbhandari/local-markdown-file-renderer.git"
  },
  "bugs": {
    "url": "https://github.com/harshitsinghbhandari/local-markdown-file-renderer/issues"
  },
  "homepage": "https://github.com/harshitsinghbhandari/local-markdown-file-renderer#readme",
  "keywords": [
    "markdown",
    "local",
    "viewer",
    "renderer",
    "daemon",
    "cli"
  ],
  "files": [
    "cli.js",
    "server.js",
    "public",
    "README.md",
    "LICENSE"
